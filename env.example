# Used by `npm run dev` locally. On Vercel, add these under Project → Settings → Environment Variables.
# Generate push keys with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Firebase service account JSON (Project settings → Service accounts → Generate new private key).
# Paste the whole JSON on one line, or base64-encode it. Leave empty to use the local emulators.
FIREBASE_SERVICE_ACCOUNT=
