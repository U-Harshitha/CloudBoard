rules_version = '2';

// CloudBoard security rules.
// Every user can only ever see and modify their own data under /users/{uid}.
// Access keys (used by the browser extension and iOS Shortcut) are server-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/clips/{clipId} {
      // New clips are created by the API (server/handler.js) so it can send push notifications.
      allow read, delete: if signedInAs(uid);
      allow create, update: if false;
    }

    match /users/{uid}/devices/{deviceId} {
      allow read, write: if signedInAs(uid);
    }

    // linkTokens/* and everything else: the API (Admin SDK) only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
