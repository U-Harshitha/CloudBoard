{
  "manifest_version": 3,
  "name": "CloudBoard",
  "version": "1.0.0",
  "description": "Ctrl+Alt+C to cloud-copy, Ctrl+Alt+V to cloud-paste. Clips from your phone land on your clipboard.",
  "minimum_chrome_version": "121",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "CloudBoard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "offscreen", "clipboardRead", "clipboardWrite", "notifications", "contextMenus", "scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "cloud-copy": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Cloud-copy the selected text (or your clipboard)"
    },
    "send-clipboard": {
      "suggested_key": { "default": "Ctrl+Shift+1" },
      "description": "Send your clipboard to CloudBoard (set to Global to use it in any app)",
      "global": true
    }
  }
}
