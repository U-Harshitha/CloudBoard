# Copy this file to functions/.env and fill in the values.
# Generate a key pair with:  cd functions && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=PASTE_PUBLIC_KEY_HERE
VAPID_SUBJECT=mailto:you@example.com
# The PRIVATE key is NOT stored here. Set it as a secret:
#   firebase functions:secrets:set VAPID_PRIVATE_KEY
